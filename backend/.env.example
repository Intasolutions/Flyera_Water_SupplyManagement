# Backend settings. Copy this file to .env and fill in your own values.
# The app loads backend/.env automatically. Real environment variables take priority.

# "production" turns on the strict checks: the app refuses to start without a strong SECRET_KEY,
# /setup always needs SETUP_MASTER_KEY, the API docs are hidden and demo seed scripts refuse to run.
APP_ENV=development

# Signs login tokens and seals the merchant UPI ID. Keep it private, and use a different value per server.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out, and the UPI ID must then be saved again in Settings.
SECRET_KEY=

# Database. SQLite paths are relative to the backend folder.
# PostgreSQL example: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=sqlite:///./water_supply.db

# Exact origins allowed to call the API directly. The browser normally goes through the Next.js proxy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for the /setup page once any user exists, and always in production.
SETUP_MASTER_KEY=

# Business time zone offset from UTC, in minutes. 330 is India (UTC+5:30).
APP_UTC_OFFSET_MINUTES=330
