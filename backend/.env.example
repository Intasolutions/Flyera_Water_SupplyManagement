# Backend Environment Variables Example

# Secret key for signing JWT tokens. Change this to a random secure string in production!
SECRET_KEY=aqua_glass_super_secret_key_change_in_production

# Database URL. For Digital Ocean App Platform, this is usually provided automatically,
# or you can set it to a managed PostgreSQL connection string.
# Example: postgresql://username:password@hostname:port/database_name
DATABASE_URL=sqlite:///./water_supply.db

# CORS Origins. A comma-separated list of allowed frontend URLs.
# Example for production: https://your-frontend-domain.vercel.app
CORS_ORIGINS=*
