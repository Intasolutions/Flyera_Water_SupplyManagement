generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      String   // "ADMIN", "DRIVER", "HELPER"
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  assignments Assignment[] @relation("DriverAssignments")
  helperAssignments Assignment[] @relation("HelperAssignments")
}

model Client {
  id            String   @id @default(uuid())
  name          String
  phone         String?
  address       String?
  loyaltyPoints Int      @default(0)
  optInLoyalty  Boolean  @default(true) // Admin can toggle this
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliveries Delivery[]
}

model Vehicle {
  id           String   @id @default(uuid())
  plateNumber  String   @unique
  model        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  Assignment[]
}

model InventoryType {
  id          String   @id @default(uuid())
  name        String   // e.g., "20L Bottle", "5L Bottle"
  price       Float    // Default price
  pointsValue Int      @default(1) // Points earned per bottle
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  stocks      Stock[]
  allocations Allocation[]
  deliveryItems DeliveryItem[]
}

model Stock {
  id              String   @id @default(uuid())
  inventoryTypeId String
  fullCount       Int      @default(0)
  emptyCount      Int      @default(0)
  damagedCount    Int      @default(0)
  updatedAt       DateTime @updatedAt

  inventoryType   InventoryType @relation(fields: [inventoryTypeId], references: [id])
}

// Daily assignment of a vehicle to a driver (and optional helper)
model Assignment {
  id          String   @id @default(uuid())
  date        DateTime // The day of the assignment
  vehicleId   String
  driverId    String
  helperId    String?
  status      String   @default("PENDING") // "PENDING", "ACTIVE", "CLOSED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  driver      User    @relation("DriverAssignments", fields: [driverId], references: [id])
  helper      User?   @relation("HelperAssignments", fields: [helperId], references: [id])
  
  allocations Allocation[]
  deliveries  Delivery[]
}

// Stock allocated to a specific vehicle for a specific assignment (day)
model Allocation {
  id              String   @id @default(uuid())
  assignmentId    String
  inventoryTypeId String
  allocatedCount  Int      // How many full bottles given
  returnedFull    Int      @default(0) // How many full bottles brought back
  returnedEmpty   Int      @default(0) // How many empty bottles brought back
  
  assignment      Assignment    @relation(fields: [assignmentId], references: [id])
  inventoryType   InventoryType @relation(fields: [inventoryTypeId], references: [id])
}

// A specific delivery made to a client during an assignment
model Delivery {
  id             String   @id @default(uuid())
  assignmentId   String
  clientId       String
  totalAmount    Float    @default(0)
  paymentMethod  String?  // "CASH", "RAZORPAY", "UNPAID"
  status         String   @default("COMPLETED") // "PENDING", "COMPLETED"
  createdAt      DateTime @default(now())

  assignment     Assignment     @relation(fields: [assignmentId], references: [id])
  client         Client         @relation(fields: [clientId], references: [id])
  items          DeliveryItem[]
}

model DeliveryItem {
  id              String   @id @default(uuid())
  deliveryId      String
  inventoryTypeId String
  deliveredFull   Int      // Full bottles given to client
  collectedEmpty  Int      // Empty bottles taken from client
  priceCharged    Float    // Price charged per unit for this delivery
  
  delivery        Delivery      @relation(fields: [deliveryId], references: [id])
  inventoryType   InventoryType @relation(fields: [inventoryTypeId], references: [id])
}
